# ---------------------------------------------------------------------------
# AI Knowledge Compiler — backend environment example
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed. Every variable maps 1:1 to a field in `apps/backend/akc/config.py`.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
AKC_ENV=development
AKC_HOST=127.0.0.1
AKC_PORT=38127
AKC_LOG_LEVEL=INFO
# Structured JSON logs (recommended for troubleshooting); set false for pretty logs.
AKC_LOG_JSON=true

# --- Storage ---------------------------------------------------------------
# SQLite file. Relative paths resolve against AKC_DATA_DIR.
AKC_DATA_DIR=./data
AKC_DATABASE_URL=sqlite+pysqlite:///./data/akc.db

# --- Security --------------------------------------------------------------
# Shared secret required by every mutating call from the extension
# (header: X-AKC-Token). Leave empty to auto-generate one into AKC_DATA_DIR.
AKC_AUTH_TOKEN=
# Comma separated list of allowed browser origins. No wildcards in production.
AKC_CORS_ORIGINS=chrome-extension://__AKC_EXTENSION_ID__

# --- Obsidian --------------------------------------------------------------
AKC_VAULT_PATH=
AKC_VAULT_RAW_FOLDER=01_Raw
AKC_VAULT_KNOWLEDGE_FOLDER=03_Knowledge
AKC_VAULT_INBOX_FOLDER=02_Inbox

# --- Claude / compiler -----------------------------------------------------
AKC_CLAUDE_ENABLED=false
# Model ids are configuration, never hard-coded business logic.
AKC_CLAUDE_MODEL=
AKC_CLAUDE_API_KEY=
AKC_CLAUDE_BASE_URL=https://api.anthropic.com
AKC_CLAUDE_MAX_CONTEXT_TOKENS=50000
AKC_CLAUDE_TIMEOUT_SECONDS=120

# --- Compile policy --------------------------------------------------------
AKC_AUTO_COMPILE=false
AKC_AUTO_MERGE_VERIFIED=false
AKC_REQUIRE_REVIEW_FOR_CONFLICTS=true

# --- Job queue -------------------------------------------------------------
AKC_JOB_POLL_INTERVAL_SECONDS=2
AKC_JOB_MAX_ATTEMPTS=3
AKC_JOB_BACKOFF_SECONDS=2,5,15
