# ---------------------------------------------------------------------------
# AI Knowledge Compiler — backend environment example
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed. Every variable maps 1:1 to a field in `apps/backend/akc/config.py`.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
AKC_ENV=development
AKC_HOST=127.0.0.1
AKC_PORT=38127
AKC_LOG_LEVEL=INFO
# Structured JSON logs (recommended for troubleshooting); set false for pretty logs.
AKC_LOG_JSON=true

# --- Storage ---------------------------------------------------------------
# SQLite file. Relative paths resolve against AKC_DATA_DIR.
AKC_DATA_DIR=./data
AKC_DATABASE_URL=sqlite+pysqlite:///./data/akc.db

# --- Security --------------------------------------------------------------
# Shared secret required by every mutating call from the extension
# (header: X-AKC-Token). Leave empty to auto-generate one into AKC_DATA_DIR.
AKC_AUTH_TOKEN=
# Comma separated list of allowed browser origins. No wildcards in production.
AKC_CORS_ORIGINS=chrome-extension://__AKC_EXTENSION_ID__

# --- Obsidian --------------------------------------------------------------
AKC_VAULT_PATH=
AKC_VAULT_RAW_FOLDER=01_Raw
AKC_VAULT_KNOWLEDGE_FOLDER=03_Knowledge
AKC_VAULT_INBOX_FOLDER=02_Inbox

# --- LLM / compiler --------------------------------------------------------
# 编译器只需要「Anthropic Messages 兼容」的接口，因此除了官方 Anthropic，
# 也可以直接接 DeepSeek 等提供 Anthropic 兼容端点的服务（国内可直连、便宜）。
AKC_LLM_ENABLED=false

# provider 只决定 base_url 预设：anthropic | deepseek | custom
#   anthropic -> https://api.anthropic.com
#   deepseek  -> https://api.deepseek.com/anthropic
#   custom    -> 需要自己填 AKC_LLM_BASE_URL（任何 Anthropic 兼容端点都行）
AKC_LLM_PROVIDER=anthropic

# 模型 ID 一律配置注入，代码里不硬编码（各 provider 的最新模型名请查官方文档）
#   DeepSeek 示例：deepseek-v4-flash（快/便宜）、deepseek-v4-pro（更强）
#   Anthropic 示例：填你自己账号可用的模型 ID
AKC_LLM_MODEL=
AKC_LLM_API_KEY=
# 留空则按 AKC_LLM_PROVIDER 预设；只有 provider=custom 时才必须手填
AKC_LLM_BASE_URL=
AKC_LLM_MAX_CONTEXT_TOKENS=50000
AKC_LLM_TIMEOUT_SECONDS=120

# --- 旧配置名（等价于上面，保留兼容；新配置请用 AKC_LLM_*）-------------------
# AKC_CLAUDE_ENABLED / AKC_CLAUDE_MODEL / AKC_CLAUDE_API_KEY
# AKC_CLAUDE_BASE_URL / AKC_CLAUDE_MAX_CONTEXT_TOKENS / AKC_CLAUDE_TIMEOUT_SECONDS

# --- Compile policy --------------------------------------------------------
AKC_AUTO_COMPILE=false
AKC_AUTO_MERGE_VERIFIED=false
AKC_REQUIRE_REVIEW_FOR_CONFLICTS=true

# --- Job queue -------------------------------------------------------------
AKC_JOB_POLL_INTERVAL_SECONDS=2
AKC_JOB_MAX_ATTEMPTS=3
AKC_JOB_BACKOFF_SECONDS=2,5,15
