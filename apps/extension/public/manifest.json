{
  "manifest_version": 3,
  "name": "AI Knowledge Compiler",
  "version": "0.1.0",
  "description": "采集 ChatGPT / Claude / DeepSeek / 豆包 / 智谱清言 的对话，编译为可复用的 Obsidian 知识。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://127.0.0.1:38127/*", "http://localhost:38127/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Knowledge Compiler (AKC)",
    "default_popup": "sidepanel/index.html"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://chatglm.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
